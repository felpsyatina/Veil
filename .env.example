########################################
# ОБЩЕЕ
########################################
ENV=production
LOG_LEVEL=INFO
TZ=Europe/Moscow

########################################
# TELEGRAM
########################################
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token
# Telegram ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=111111111,222222222
# Юзернейм для связи с поддержкой (используется в текстах, тикеты всё равно обрабатываются в боте)
SUPPORT_USERNAME=@your_support

########################################
# БАЗА ДАННЫХ (PostgreSQL)
########################################
POSTGRES_DB=vpnshop
POSTGRES_USER=vpnshop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Собирается автоматически из переменных выше в config.py, но можно переопределить целиком
DATABASE_URL=postgresql+asyncpg://vpnshop:change_me_strong_password@postgres:5432/vpnshop

########################################
# REDIS (FSM бота, троттлинг, кэш статусов нод)
########################################
REDIS_URL=redis://redis:6379/0

########################################
# БЕЗОПАСНОСТЬ
########################################
# 32-байтный ключ Fernet для шифрования паролей панелей 3x-ui в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

########################################
# ДОМЕН И ПУБЛИЧНЫЙ API (вебхуки платежей + ссылки подписок)
########################################
# Домен, на который смотрит DNS A-запись сервера с ботом (для авто-HTTPS через Caddy)
DOMAIN=sub.example.com
ACME_EMAIL=you@example.com
# Публичный базовый URL API — используется при формировании subscription-ссылок
SUBSCRIPTION_BASE_URL=https://sub.example.com

########################################
# БИЗНЕС-ЛОГИКА
########################################
TRIAL_DAYS=3
DEVICE_LIMIT=1
REFERRAL_PERCENT=10
# За сколько дней до окончания подписки слать напоминания (через запятую)
NOTIFY_BEFORE_DAYS=3,1

########################################
# ПЛАТЕЖИ
########################################
# manual — ручное подтверждение админом (для старта/теста без реального эквайринга)
# yookassa — рабочая интеграция с ЮKassa (см. docs/PAYMENTS.md)
PAYMENT_PROVIDER=manual

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда возвращать пользователя после оплаты — обычно диплинк на бота
YOOKASSA_RETURN_URL=https://t.me/your_bot

########################################
# REALITY (значения по умолчанию для новых нод — можно менять при добавлении конкретной ноды)
########################################
# ВАЖНО: подберите и проверьте домен камуфляжа сами (см. README) — конкретные
# рекомендации по SNI быстро устаревают.
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com
REALITY_FINGERPRINT=chrome

########################################
# РЕЗЕРВНОЕ КОПИРОВАНИЕ
########################################
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# Час (0-23, время TZ выше), в который worker снимает бэкап БД
BACKUP_HOUR=4

########################################
# АНТИФРОД / RATE LIMIT
########################################
# Сколько попыток создать платёж разрешено одному пользователю за окно (сек)
PAYMENT_RATE_LIMIT_COUNT=5
PAYMENT_RATE_LIMIT_WINDOW_SEC=3600
